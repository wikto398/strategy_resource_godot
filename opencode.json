{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ruff-lsp": {
      "command": ["ruff", "server", "--preview"],
      "extensions": [".py", ".pyi"]
    },
    "gdscript": {
      "command": ["npx", "opencode-godot-lsp"],
      "extensions": [".gd", ".gdshader"]
    }
  }
}
